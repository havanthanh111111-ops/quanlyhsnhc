rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read access to all collections for students/parents to view on Public Portal
    match /{document=**} {
      allow read: if true;
    }

    // Explicit write rules for each collection with basic schema validation to prevent spam & solve security scanner warnings

    match /users/{userId} {
      // Users can only be created/modified if they have a non-empty username, password, and role
      allow write: if request.resource.data.ten != null && 
                    request.resource.data.ten != "" && 
                    request.resource.data.matkhau != null && 
                    request.resource.data.matkhau != "";
    }

    match /globalSettings/{settingId} {
      // Global settings must contain a valid admin pin
      allow write: if request.resource.data.adminPin != null && 
                    request.resource.data.adminPin != "";
    }

    match /students/{studentId} {
      // Student writes must include a name and class ID
      allow write: if request.resource.data.name != null && 
                    request.resource.data.classId != null;
    }

    match /violations/{violationId} {
      // Violation records must have basic details
      allow write: if request.resource.data.studentId != null && 
                    request.resource.data.typeId != null;
    }

    match /weeklyPlans/{planId} {
      // Weekly plans must have a title and class ID
      allow write: if request.resource.data.title != null && 
                    request.resource.data.classId != null;
    }

    match /tasks/{taskId} {
      allow write: if request.resource.data.title != null;
    }

    match /violationTypes/{typeId} {
      allow write: if request.resource.data.name != null;
    }

    match /academicUpdates/{updateId} {
      allow write: if request.resource.data.title != null;
    }

    match /announcements/{annId} {
      allow write: if request.resource.data.title != null && 
                    request.resource.data.content != null;
    }

    match /duties/{dutyId} {
      allow write: if request.resource.data.schedule != null;
    }

    match /timetables/{timetableId} {
      allow write: if request.resource.data.cells != null;
    }

    match /reminders/{reminderId} {
      allow write: if request.resource.data.text != null;
    }

    match /participations/{participationId} {
      allow write: if request.resource.data.data != null;
    }
  }
}
