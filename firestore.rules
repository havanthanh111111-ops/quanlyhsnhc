rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to all collections for students/parents/public portal
    match /{document=**} {
      allow read: if true;
    }

    // Collection security rules for system management
    match /users/{userId} {
      allow create, update, delete: if true;
    }

    match /settings/{settingId} {
      allow create, update, delete: if true;
    }

    match /globalSettings/{settingId} {
      allow create, update, delete: if true;
    }

    match /teachers/{teacherId} {
      allow create, update, delete: if true;
    }

    match /schoolYears/{yearId} {
      allow create, update, delete: if true;
    }

    match /classes/{classId} {
      allow create, update, delete: if true;
    }

    match /students/{studentId} {
      allow create, update, delete: if true;
    }

    match /violations/{violationId} {
      allow create, update, delete: if true;
    }

    match /violationTypes/{typeId} {
      allow create, update, delete: if true;
    }

    match /plans/{planId} {
      allow create, update, delete: if true;
    }

    match /weeklyPlans/{planId} {
      allow create, update, delete: if true;
    }

    match /tasks/{taskId} {
      allow create, update, delete: if true;
    }

    match /academicUpdates/{updateId} {
      allow create, update, delete: if true;
    }

    match /announcements/{annId} {
      allow create, update, delete: if true;
    }

    match /duties/{dutyId} {
      allow create, update, delete: if true;
    }

    match /timetables/{timetableId} {
      allow create, update, delete: if true;
    }

    match /reminders/{reminderId} {
      allow create, update, delete: if true;
    }

    match /participations/{participationId} {
      allow create, update, delete: if true;
    }

    match /documentCategories/{categoryId} {
      allow create, update, delete: if true;
    }

    match /albums/{albumId} {
      allow create, update, delete: if true;
    }

    match /communityActivities/{activityId} {
      allow create, update, delete: if true;
    }
  }
}
